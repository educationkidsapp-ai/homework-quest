{
  "permissions": {
    "health.read": ["PUBLIC"],
    "panel.read": ["PUBLIC"],
    "media.read": ["PUBLIC"],
    "auth.signIn": ["PUBLIC"],
    "auth.refresh": ["PUBLIC"],
    "auth.forgotPassword": ["PUBLIC"],
    "auth.resetPassword": ["PUBLIC"],
    "auth.changePassword": ["ADMIN", "TEACHER", "MANAGERIAL"],
    "school.join": ["PUBLIC"],
    "child.read": ["PARENT"],
    "child.write": ["PARENT"],
    "child.play": ["PARENT"],
    "lesson.play": ["PARENT"],
    "lesson.read": ["ADMIN", "TEACHER", "MANAGERIAL"],
    "lesson.write": ["ADMIN", "TEACHER"],
    "lesson.publish": ["ADMIN", "TEACHER"],
    "lesson.delete": ["ADMIN", "TEACHER"],
    "play.write": ["ADMIN", "TEACHER"],
    "stop.write": ["ADMIN", "TEACHER"],
    "cache.read": ["ADMIN"],
    "usage.read": ["ADMIN", "MANAGERIAL"],
    "calendar.read": ["ADMIN", "TEACHER", "MANAGERIAL"],
    "school.read": ["ADMIN", "TEACHER", "MANAGERIAL"],
    "school.write": ["ADMIN"],
    "user.read": ["ADMIN", "MANAGERIAL"],
    "user.invite": ["ADMIN", "MANAGERIAL"],
    "user.impersonate": ["ADMIN"],
    "me.read": ["ADMIN", "TEACHER", "MANAGERIAL"],
    "me.permissions": ["ADMIN", "TEACHER", "MANAGERIAL"]
  },
  "endpoints": [
    { "method": "GET", "path": "/health", "permission": "health.read" },
    { "method": "GET", "path": "/panel", "permission": "panel.read" },
    { "method": "GET", "path": "/panel/", "permission": "panel.read" },
    { "method": "GET", "path": "/panel/**", "permission": "panel.read" },
    { "method": "GET", "path": "/media/pages/{id}", "permission": "media.read" },
    { "method": "GET", "path": "/media/child/{id}", "permission": "media.read" },

    { "method": "POST", "path": "/admin/auth/sign-in", "permission": "auth.signIn" },
    { "method": "POST", "path": "/auth/sign-in", "permission": "auth.signIn" },
    { "method": "POST", "path": "/auth/refresh", "permission": "auth.refresh" },
    { "method": "POST", "path": "/auth/forgot-password", "permission": "auth.forgotPassword" },
    { "method": "POST", "path": "/auth/reset-password", "permission": "auth.resetPassword" },
    { "method": "POST", "path": "/auth/change-password", "permission": "auth.changePassword" },

    { "method": "GET", "path": "/me", "permission": "me.read" },
    { "method": "GET", "path": "/me/permissions", "permission": "me.permissions" },

    { "method": "GET", "path": "/children", "permission": "child.read" },
    { "method": "POST", "path": "/children", "permission": "child.write" },
    { "method": "PATCH", "path": "/children/{id}", "permission": "child.write" },
    { "method": "DELETE", "path": "/children/{id}", "permission": "child.write" },
    { "method": "GET", "path": "/children/{id}/map", "permission": "child.read" },
    { "method": "GET", "path": "/children/{id}/progress", "permission": "child.read" },
    { "method": "POST", "path": "/children/{id}/attempts", "permission": "child.play" },
    { "method": "POST", "path": "/children/{id}/stops/{stopId}/media", "permission": "child.play" },
    { "method": "GET", "path": "/lessons/{id}", "permission": "lesson.play" },
    { "method": "GET", "path": "/schools/by-code/{code}", "permission": "school.join" },

    { "method": "GET", "path": "/admin/lessons", "permission": "lesson.read" },
    { "method": "POST", "path": "/admin/lessons", "permission": "lesson.write" },
    { "method": "GET", "path": "/admin/lessons/{id}", "permission": "lesson.read" },
    { "method": "DELETE", "path": "/admin/lessons/{id}", "permission": "lesson.delete" },
    { "method": "DELETE", "path": "/admin/lessons/failed", "permission": "lesson.delete" },
    { "method": "POST", "path": "/admin/lessons/{id}/files", "permission": "lesson.write" },
    { "method": "DELETE", "path": "/admin/lessons/{id}/files", "permission": "lesson.write" },
    { "method": "POST", "path": "/admin/lessons/{id}/images", "permission": "lesson.write" },
    { "method": "POST", "path": "/admin/lessons/{id}/analyze", "permission": "lesson.write" },
    { "method": "POST", "path": "/admin/lessons/{id}/skills", "permission": "lesson.write" },
    { "method": "POST", "path": "/admin/lessons/{id}/generate-from-text", "permission": "lesson.write" },
    { "method": "POST", "path": "/admin/lessons/{id}/retry", "permission": "lesson.write" },
    { "method": "POST", "path": "/admin/lessons/{id}/steps/{step}/retry", "permission": "lesson.write" },
    { "method": "PUT", "path": "/admin/lessons/{id}/parent-panel", "permission": "lesson.write" },
    { "method": "POST", "path": "/admin/lessons/{id}/publish", "permission": "lesson.publish" },
    { "method": "POST", "path": "/admin/lessons/{id}/unpublish", "permission": "lesson.publish" },
    { "method": "POST", "path": "/admin/lessons/{id}/plays", "permission": "play.write" },
    { "method": "PUT", "path": "/admin/plays/{playId}/order", "permission": "play.write" },
    { "method": "POST", "path": "/admin/plays/{playId}/regenerate", "permission": "play.write" },
    { "method": "POST", "path": "/admin/plays/{playId}/stops", "permission": "stop.write" },
    { "method": "PUT", "path": "/admin/stops/{stopId}", "permission": "stop.write" },
    { "method": "DELETE", "path": "/admin/stops/{stopId}", "permission": "stop.write" },
    { "method": "POST", "path": "/admin/stops/{stopId}/regenerate", "permission": "stop.write" },

    { "method": "GET", "path": "/admin/cache", "permission": "cache.read" },
    { "method": "GET", "path": "/admin/usage", "permission": "usage.read" },
    { "method": "GET", "path": "/admin/calendar", "permission": "calendar.read" },

    { "method": "GET", "path": "/admin/schools", "permission": "school.read" },
    { "method": "POST", "path": "/admin/schools", "permission": "school.write" },
    { "method": "GET", "path": "/admin/schools/{id}", "permission": "school.read" },
    { "method": "PUT", "path": "/admin/schools/{id}", "permission": "school.write" },
    { "method": "GET", "path": "/admin/schools/{id}/users", "permission": "user.read" },
    { "method": "POST", "path": "/admin/schools/{id}/invites", "permission": "user.invite" },
    { "method": "POST", "path": "/admin/users/{id}/impersonate", "permission": "user.impersonate" }
  ]
}

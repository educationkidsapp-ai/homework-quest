# Copy to .env (git-ignored). Used by docker-compose.yml and deploy/gcloud.sh.

# Which model reads the slides and writes the questions: anthropic | deepseek | fake
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash          # vision-capable; PDFs are rendered to PNG pages server-side
DEEPSEEK_BASE_URL=https://api.deepseek.com

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set FAKE_LLM=true to run the whole loop without an API key (answers from the shared sample outputs).
FAKE_LLM=false

DB_NAME=quest
DB_USER=quest
DB_PASSWORD=change-me

# Google Cloud (deploy/gcloud.sh)
GCP_PROJECT=my-project
GCP_REGION=me-central1

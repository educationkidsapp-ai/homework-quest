# Copy to .env (git-ignored). Used by docker-compose.yml and deploy/gcloud.sh.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Set FAKE_LLM=true to run the whole loop without an API key (answers from the shared sample outputs).
FAKE_LLM=false

DB_NAME=quest
DB_USER=quest
DB_PASSWORD=change-me

# Google Cloud (deploy/gcloud.sh)
GCP_PROJECT=my-project
GCP_REGION=me-central1

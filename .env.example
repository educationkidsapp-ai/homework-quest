# Copy to .env (git-ignored). Used by docker-compose.yml, deploy/gcloud.sh and `server/run-local.sh`.

# Which model reads the slides and writes the plays: deepseek | anthropic | fake
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-pro         # Prompts B and C (text)
DEEPSEEK_VISION_MODEL=deepseek-flash   # Prompt A (page images; PDFs are rendered to PNG server-side)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=16384

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Platform ADMIN (school_id = null), seeded on every start when both are set
ADMIN_EMAIL=admin@quest.local
ADMIN_PASSWORD=change-me
# Signs dashboard access tokens; at least 32 bytes. Terraform generates one per deployed environment.
ADMIN_JWT_SECRET=a-long-random-string-at-least-32-bytes

# Invite and password-reset email. `log` (the default) logs the subject and a redacted recipient and never the body,
# so no link leaves the server — set `resend` with a key to actually deliver them.
MAIL_PROVIDER=log                # log | resend
RESEND_API_KEY=                  # required when MAIL_PROVIDER=resend
MAIL_FROM=no-reply@localhost     # the verified sender

# Origin the dashboard is served from; invite / reset links are built as <DASHBOARD_URL>/dashboard/... Blank = PUBLIC_URL.
DASHBOARD_URL=
# Directory holding the built Angular dashboard, served at /dashboard/ (the Docker image sets it). Blank = 404.
DASHBOARD_DIR=
# The user-facing product name (§A) is NOT an env var: it is the `platform_settings` row, seeded by
# V5__flags_themes.sql and edited by Admin through PUT /admin/platform-settings. See docs/runbook.md.

# One-school seed (SchoolSeed): 30 classes, 40 teachers, 600 children from server/src/main/resources/seed/*.csv into
# the default school. Idempotent, so a re-run only scans (~0.4 s). Default false; the `qa` and `h2` profiles default it
# on, `prod` has no such bean. Set it here to seed a `local` run.
SEED_SCHOOL=                     # true | false (blank = the profile default)
# The one password every seeded teacher shares, with must_change_password cleared, so e2e can sign in as any of them.
# Blank = each teacher keeps her own generated password, which nothing prints. On QA it is a Secret Manager secret.
SEED_STAFF_PASSWORD=

# Firebase (parents). Leave empty and use SPRING_PROFILES_ACTIVE=local|h2 for FAKE_AUTH.
FIREBASE_CREDENTIALS=            # path to the service-account JSON (or the JSON itself)

DB_NAME=quest
DB_USER=quest
DB_PASSWORD=change-me

# Public base URL the server puts in media links (Cloud Run URL in production)
PUBLIC_URL=http://localhost:8080
# Admin panel origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:8081

# Google Cloud: see deploy/README.md — infra/bootstrap.sh qa|prod reads DEEPSEEK_API_KEY, ADMIN_PASSWORD, FIREBASE_CREDENTIALS,
# FIREBASE_TOKEN and the optional ANDROID_KEYSTORE_* values from the environment and stores them with gh secret set.

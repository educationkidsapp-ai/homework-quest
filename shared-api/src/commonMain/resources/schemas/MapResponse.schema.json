{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://homeworkquest.app/schemas/MapResponse.json",
 "title": "MapResponse",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "childId",
  "course",
  "from",
  "to",
  "today",
  "islands"
 ],
 "properties": {
  "childId": {
   "type": "string",
   "minLength": 1,
   "maxLength": 60
  },
  "course": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "curriculum",
    "grade"
   ],
   "properties": {
    "curriculum": {
     "enum": [
      "american",
      "british"
     ]
    },
    "grade": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    }
   }
  },
  "from": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "to": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "today": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "islands": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "date",
     "state",
     "title"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "kind": {
      "enum": [
       "lesson",
       "review",
       "locked"
      ]
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "state": {
      "enum": [
       "done",
       "waiting",
       "today",
       "locked"
      ]
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     },
     "subject": {
      "enum": [
       "math",
       "english"
      ]
     },
     "lessonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "lessonVersion": {
      "type": "integer",
      "minimum": 1
     },
     "levelsUnlocked": {
      "type": "array",
      "items": {
       "enum": [
        1,
        2,
        3
       ]
      }
     },
     "completedLevels": {
      "type": "array",
      "items": {
       "enum": [
        1,
        2,
        3
       ]
      }
     },
     "starsEarned": {
      "type": "integer",
      "minimum": 0
     },
     "starsTotal": {
      "type": "integer",
      "minimum": 0
     },
     "skillId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "playId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "kind": {
         "const": "lesson"
        }
       }
      },
      "then": {
       "required": [
        "lessonId",
        "lessonVersion",
        "subject",
        "levelsUnlocked"
       ]
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "review"
        }
       }
      },
      "then": {
       "required": [
        "skillId",
        "playId"
       ]
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "locked"
        }
       }
      },
      "then": {
       "properties": {
        "state": {
         "const": "locked"
        }
       }
      }
     }
    ]
   }
  }
 }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeworkquest.app/schemas/QuestionSet.json",
  "title": "QuestionSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["skillId", "mode", "explanation", "workedExamples", "questions"],
  "properties": {
    "skillId": { "type": "string" },
    "mode": { "enum": ["normal", "again", "harder", "easier"] },
    "explanation": { "type": "string", "maxLength": 80, "pattern": "^(\\S+\\s+){0,11}\\S+$" },
    "workedExamples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "steps", "answer"],
        "properties": {
          "prompt": { "type": "string", "maxLength": 60 },
          "steps": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 60 } },
          "answer": { "type": "string", "maxLength": 20 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 1, "maxLength": 12 }
      }
    },
    "numberLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "step"],
      "properties": {
        "from": { "type": "integer" },
        "to": { "type": "integer" },
        "step": { "type": "integer", "minimum": 1 },
        "highlight": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "illustrationKey": {
      "enum": [
        "ship", "sheep", "shop", "shell", "shoe", "fish",
        "chair", "cheese", "chick", "chips",
        "thumb", "three", "bath", "moth",
        "sun", "sock", "cat", "dog", "hat", "bed", "cup", "pen", "pig", "bus", "fox",
        "apple", "ball", "tree", "bee", "moon", "star", "car"
      ]
    },
    "hint": { "type": "string", "minLength": 3, "maxLength": 90 },
    "question": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "hint", "chips", "options", "correctOptionId", "numberLine"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "sequence" },
            "hint": { "$ref": "#/$defs/hint" },
            "chips": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": ["integer", "null"] } },
            "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } },
            "correctOptionId": { "type": "string" },
            "numberLine": { "$ref": "#/$defs/numberLine" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "hint", "objectKey", "groupSizes", "options", "correctOptionId", "numberLine"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "count" },
            "hint": { "$ref": "#/$defs/hint" },
            "objectKey": { "$ref": "#/$defs/illustrationKey" },
            "groupSizes": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "integer", "minimum": 1, "maximum": 5 } },
            "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } },
            "correctOptionId": { "type": "string" },
            "numberLine": { "$ref": "#/$defs/numberLine" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "hint", "left", "right", "options", "correctOptionId", "numberLine"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "compare" },
            "hint": { "$ref": "#/$defs/hint" },
            "left": { "type": "integer" },
            "right": { "type": "integer" },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label"],
                "properties": { "id": { "type": "string" }, "label": { "enum": ["<", ">", "="] } }
              }
            },
            "correctOptionId": { "type": "string" },
            "numberLine": { "$ref": "#/$defs/numberLine" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "hint", "illustrationKey", "options", "correctOptionId"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "sound" },
            "hint": { "$ref": "#/$defs/hint" },
            "illustrationKey": { "$ref": "#/$defs/illustrationKey" },
            "options": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/option" } },
            "correctOptionId": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "hint", "spokenWord", "options", "correctOptionId"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "word" },
            "hint": { "$ref": "#/$defs/hint" },
            "spokenWord": { "type": "string", "minLength": 1, "maxLength": 12 },
            "options": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/option" } },
            "correctOptionId": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "hint", "letter"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "trace" },
            "hint": { "$ref": "#/$defs/hint" },
            "letter": { "type": "string", "pattern": "^[A-Za-z]$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "hint", "word", "options", "correctOptionId"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "readTap" },
            "hint": { "$ref": "#/$defs/hint" },
            "word": { "type": "string", "minLength": 1, "maxLength": 12 },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "illustrationKey"],
                "properties": { "id": { "type": "string" }, "illustrationKey": { "$ref": "#/$defs/illustrationKey" } }
              }
            },
            "correctOptionId": { "type": "string" }
          }
        }
      ]
    }
  }
}

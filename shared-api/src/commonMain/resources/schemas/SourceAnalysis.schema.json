{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://homeworkquest.app/schemas/SourceAnalysis.json",
 "title": "SourceAnalysis",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "title",
  "pages",
  "skills",
  "objectives"
 ],
 "properties": {
  "kind": {
   "enum": [
    "story",
    "informational",
    "math",
    "phonics",
    "vocabulary",
    "mixed"
   ]
  },
  "title": {
   "type": "string",
   "minLength": 1,
   "maxLength": 60
  },
  "pages": {
   "type": "array",
   "minItems": 1,
   "maxItems": 40,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "number",
     "childText",
     "pictureDescription"
    ],
    "properties": {
     "number": {
      "type": "integer",
      "minimum": 1
     },
     "childText": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 90
      }
     },
     "pictureDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     },
     "illustrationKeys": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/illustrationKey"
      }
     },
     "keepImage": {
      "type": "boolean"
     }
    }
   }
  },
  "skills": {
   "type": "array",
   "minItems": 1,
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "subject",
     "method",
     "examples",
     "slideNumbers",
     "confidence"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,40}$"
     },
     "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40
     },
     "subject": {
      "enum": [
       "math",
       "english"
      ]
     },
     "method": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
     },
     "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      }
     },
     "slideNumbers": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "integer",
       "minimum": 1
      }
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "unsure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "candidates",
       "question"
      ],
      "properties": {
       "candidates": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "string",
         "minLength": 3,
         "maxLength": 40
        }
       },
       "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       }
      }
     }
    },
    "if": {
     "properties": {
      "confidence": {
       "exclusiveMaximum": 0.7
      }
     }
    },
    "then": {
     "required": [
      "unsure"
     ]
    }
   }
  },
  "vocabulary": {
   "type": "array",
   "minItems": 0,
   "maxItems": 12,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "word",
     "meaning",
     "sentence",
     "illustrationKey"
    ],
    "properties": {
     "word": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
     },
     "meaning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "sentence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     },
     "illustrationKey": {
      "$ref": "#/$defs/illustrationKey"
     }
    }
   }
  },
  "storyPieces": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "genre",
    "characters",
    "setting",
    "problem",
    "resolution"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 60
    },
    "genre": {
     "enum": [
      "real",
      "fantasy"
     ]
    },
    "characters": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
     }
    },
    "setting": {
     "type": "string",
     "minLength": 1,
     "maxLength": 90
    },
    "problem": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120
    },
    "resolution": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120
    }
   }
  },
  "events": {
   "type": "array",
   "minItems": 0,
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "pageNumber": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "facts": {
   "type": "array",
   "minItems": 0,
   "maxItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "trueStatement",
     "falseTwin"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "trueStatement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
     },
     "falseTwin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
     },
     "pageNumber": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "objectives": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "en",
    "ar"
   ],
   "properties": {
    "en": {
     "type": "array",
     "minItems": 3,
     "maxItems": 5,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
     }
    },
    "ar": {
     "type": "array",
     "minItems": 3,
     "maxItems": 5,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
     }
    }
   }
  }
 },
 "$defs": {
  "illustrationKey": {
   "enum": [
    "ship",
    "sheep",
    "shop",
    "shell",
    "shoe",
    "fish",
    "chair",
    "cheese",
    "chick",
    "chips",
    "thumb",
    "three",
    "bath",
    "moth",
    "sun",
    "sock",
    "cat",
    "dog",
    "hat",
    "bed",
    "cup",
    "pen",
    "pig",
    "bus",
    "fox",
    "apple",
    "ball",
    "tree",
    "bee",
    "moon",
    "star",
    "car",
    "carrot",
    "potato",
    "onion",
    "tomato",
    "pea",
    "corn",
    "soup",
    "pot",
    "spoon",
    "bowl",
    "fridge",
    "mummy",
    "daddy",
    "boy",
    "girl",
    "house",
    "kitchen",
    "hike",
    "mountain",
    "backpack",
    "water",
    "bread",
    "egg",
    "milk",
    "leaf",
    "flower",
    "rain",
    "cloud",
    "boat",
    "bike",
    "book",
    "pencil",
    "school",
    "bag",
    "door",
    "window",
    "hand",
    "foot",
    "eye",
    "ear",
    "nose",
    "mouth",
    "heart",
    "gift",
    "cake",
    "balloon",
    "kite",
    "drum",
    "bell",
    "key",
    "lock",
    "clock",
    "map",
    "flag",
    "ladder",
    "rope",
    "tent",
    "fire",
    "ice",
    "snow",
    "wind"
   ]
  }
 }
}
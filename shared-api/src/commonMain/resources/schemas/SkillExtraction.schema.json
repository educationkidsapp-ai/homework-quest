{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeworkquest.app/schemas/SkillExtraction.json",
  "title": "SkillExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "skills"],
  "properties": {
    "subject": { "enum": ["math", "english"] },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "subject", "method", "examples", "slideNumbers", "confidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 40 },
          "subject": { "enum": ["math", "english"] },
          "method": { "type": "string", "minLength": 3, "maxLength": 120 },
          "examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "maxLength": 120 }
          },
          "slideNumbers": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "unsure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidates", "question"],
            "properties": {
              "candidates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "string", "minLength": 3, "maxLength": 40 }
              },
              "question": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "if": { "properties": { "confidence": { "exclusiveMaximum": 0.7 } } },
        "then": { "required": ["unsure"] }
      }
    }
  }
}

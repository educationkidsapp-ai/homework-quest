# Single place for every Google Cloud name. Source it: `set -a; source deploy/variables.env; set +a`.
PROJECT_ID=${PROJECT_ID:-my-gcp-project}
REGION=${REGION:-me-central1}              # close to the Middle East; europe-west1 also works
SERVICE=${SERVICE:-homework-quest-api}
AR_REPO=${AR_REPO:-homework-quest}
IMAGE=${IMAGE:-${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/${SERVICE}}
SQL_INSTANCE=${SQL_INSTANCE:-homework-quest-db}
SQL_TIER=${SQL_TIER:-db-f1-micro}
DB_NAME=${DB_NAME:-quest}
DB_USER=${DB_USER:-quest}
BUCKET=${BUCKET:-${PROJECT_ID}-homework-quest-uploads}
SERVICE_ACCOUNT=${SERVICE_ACCOUNT:-${SERVICE}-sa}
LLM_PROVIDER=${LLM_PROVIDER:-deepseek}
DEEPSEEK_MODEL=${DEEPSEEK_MODEL:-deepseek-v4-pro}
DEEPSEEK_VISION_MODEL=${DEEPSEEK_VISION_MODEL:-deepseek-flash}
ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-claude-opus-5}

-- The child's own data on the device (dev prompt §6 mirror) plus the published-lesson cache.

CREATE TABLE Child (
    id TEXT NOT NULL PRIMARY KEY,
    parentUid TEXT NOT NULL,
    name TEXT NOT NULL,
    avatarColor TEXT NOT NULL,
    curriculum TEXT NOT NULL,
    grade INTEGER NOT NULL,
    languages TEXT NOT NULL
);

CREATE TABLE LessonCache (
    id TEXT NOT NULL PRIMARY KEY,
    version INTEGER NOT NULL,
    json TEXT NOT NULL,
    fetchedAt INTEGER NOT NULL
);

CREATE TABLE StopCompletion (
    childId TEXT NOT NULL,
    lessonId TEXT NOT NULL,
    level INTEGER NOT NULL,
    variant INTEGER NOT NULL,
    stopId TEXT NOT NULL,
    stars INTEGER NOT NULL,
    completedAt INTEGER NOT NULL,
    recordingPath TEXT,
    drawingPath TEXT,
    PRIMARY KEY (childId, lessonId, level, variant, stopId)
);

CREATE TABLE LessonCompletion (
    childId TEXT NOT NULL,
    lessonId TEXT NOT NULL,
    level INTEGER NOT NULL,
    variant INTEGER NOT NULL,
    starsEarned INTEGER NOT NULL,
    starsTotal INTEGER NOT NULL,
    mostStopsTwoStars INTEGER NOT NULL,
    certificateIssued INTEGER NOT NULL,
    completedAt INTEGER NOT NULL,
    PRIMARY KEY (childId, lessonId, level, variant)
);

CREATE TABLE Attempt (
    id TEXT NOT NULL PRIMARY KEY,
    childId TEXT NOT NULL,
    stopId TEXT NOT NULL,
    lessonId TEXT NOT NULL,
    level INTEGER NOT NULL,
    skillIds TEXT NOT NULL,
    answerJson TEXT NOT NULL,
    correct INTEGER NOT NULL,
    attemptNumber INTEGER NOT NULL,
    mistakes INTEGER NOT NULL,
    stars INTEGER NOT NULL,
    answeredAt INTEGER NOT NULL,
    uploaded INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE ParentUnlock (
    childId TEXT NOT NULL,
    lessonId TEXT NOT NULL,
    level INTEGER NOT NULL,
    PRIMARY KEY (childId, lessonId, level)
);

CREATE TABLE Sticker (
    id TEXT NOT NULL PRIMARY KEY,
    childId TEXT NOT NULL,
    key TEXT NOT NULL,
    earnedAt INTEGER NOT NULL
);

CREATE TABLE Streak (
    childId TEXT NOT NULL PRIMARY KEY,
    currentDays INTEGER NOT NULL,
    lastPlayedDate TEXT
);

CREATE TABLE Setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE INDEX attempt_child ON Attempt(childId, uploaded);
CREATE INDEX attempt_stop ON Attempt(childId, stopId, attemptNumber);

-- Child --------------------------------------------------------------------
selectChildren:
SELECT * FROM Child WHERE parentUid = ? ORDER BY name;

selectChild:
SELECT * FROM Child WHERE id = ?;

upsertChild:
INSERT OR REPLACE INTO Child(id, parentUid, name, avatarColor, curriculum, grade, languages) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteChild:
DELETE FROM Child WHERE id = ?;

-- LessonCache ---------------------------------------------------------------
upsertLesson:
INSERT OR REPLACE INTO LessonCache(id, version, json, fetchedAt) VALUES (?, ?, ?, ?);

selectLesson:
SELECT * FROM LessonCache WHERE id = ?;

selectLessonVersions:
SELECT id, version FROM LessonCache;

-- Completions ----------------------------------------------------------------
upsertStopCompletion:
INSERT OR REPLACE INTO StopCompletion(childId, lessonId, level, variant, stopId, stars, completedAt, recordingPath, drawingPath) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectStopCompletions:
SELECT * FROM StopCompletion WHERE childId = ? AND lessonId = ? AND level = ? AND variant = ?;

upsertLessonCompletion:
INSERT OR REPLACE INTO LessonCompletion(childId, lessonId, level, variant, starsEarned, starsTotal, mostStopsTwoStars, certificateIssued, completedAt) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectLessonCompletions:
SELECT * FROM LessonCompletion WHERE childId = ?;

selectLessonCompletionsFor:
SELECT * FROM LessonCompletion WHERE childId = ? AND lessonId = ?;

selectCompletionDates:
SELECT lessonId, level, completedAt FROM LessonCompletion WHERE childId = ? ORDER BY completedAt DESC;

-- Attempts --------------------------------------------------------------------
insertAttempt:
INSERT INTO Attempt(id, childId, stopId, lessonId, level, skillIds, answerJson, correct, attemptNumber, mistakes, stars, answeredAt, uploaded) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0);

selectPendingAttempts:
SELECT * FROM Attempt WHERE childId = ? AND uploaded = 0 ORDER BY answeredAt LIMIT 200;

markAttemptsUploaded:
UPDATE Attempt SET uploaded = 1 WHERE id IN ?;

selectFirstTryResultsForSkill:
SELECT correct FROM Attempt WHERE childId = ? AND attemptNumber = 1 AND skillIds LIKE ? ORDER BY answeredAt DESC LIMIT 14;

countAttempts:
SELECT COUNT(*) FROM Attempt WHERE childId = ?;

-- Parent unlock ----------------------------------------------------------------
upsertParentUnlock:
INSERT OR REPLACE INTO ParentUnlock(childId, lessonId, level) VALUES (?, ?, ?);

selectParentUnlocks:
SELECT * FROM ParentUnlock WHERE childId = ?;

-- Sticker / Streak ---------------------------------------------------------------
insertSticker:
INSERT INTO Sticker(id, childId, key, earnedAt) VALUES (?, ?, ?, ?);

selectStickers:
SELECT * FROM Sticker WHERE childId = ? ORDER BY earnedAt;

selectStreak:
SELECT * FROM Streak WHERE childId = ?;

upsertStreak:
INSERT OR REPLACE INTO Streak(childId, currentDays, lastPlayedDate) VALUES (?, ?, ?);

-- Setting ----------------------------------------------------------------------------
selectSetting:
SELECT value FROM Setting WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO Setting(key, value) VALUES (?, ?);

deleteSetting:
DELETE FROM Setting WHERE key = ?;
